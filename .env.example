# ─── 平台管理配置 ─────────────────────────────────────────────────────────────

# 管理员密码（必填）
ADMIN_PASSWORD=your-admin-password-here

# JWT 签名密钥（必填，建议使用随机字符串）
JWT_SECRET=your-jwt-secret-here

# 数据库文件路径（Docker 内路径，通常不需要修改）
DB_PATH=/data/wecom-platform.db

# API 服务端口（默认 3000）
API_PORT=3000

# Web 管理台端口（默认 8080）
WEB_PORT=8080

# ─── 旧版单机器人配置（已废弃，保留供参考）──────────────────────────────────
# 机器人配置现在通过管理控制台 Web UI 进行配置
# WECOM_BOT_ID=your_bot_id_here
# WECOM_BOT_SECRET=your_bot_secret_here
# WECOM_WS_URL=wss://openws.work.weixin.qq.com
# LLM_API_KEY=your_llm_api_key_here
# LLM_BASE_URL=https://your_llm_api_base_url_here
# MCP_REMOTE_URL=http://your_mcp_server_ip:1348/sse
