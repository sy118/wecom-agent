# ─── 平台管理配置 ─────────────────────────────────────────────────────────────

# 管理员密码（必填）
ADMIN_PASSWORD=your-admin-password-here

# JWT 签名密钥（必填，建议使用随机字符串）
JWT_SECRET=your-jwt-secret-here

# 数据库文件路径（Docker 内路径，通常不需要修改）
DB_PATH=/data/wecom-platform.db

# API 服务端口（默认 3000）
API_PORT=3000

# API 服务监听地址；Web 开发代理默认连接该地址
API_HOST=127.0.0.1

# Web 管理台端口（默认 8080）
WEB_PORT=8080

# Web 管理台监听地址；需要局域网访问时可改为 0.0.0.0
WEB_HOST=127.0.0.1

# Wiki 知识库根目录
# 本地开发建议改成绝对路径，确保 API 和 wiki-mcp-server 读取同一个目录。
# Windows 示例：WIKI_ROOT=E:/jiuji_project/wecom-agent/apps/api/data/wiki
# Linux/macOS 示例：WIKI_ROOT=/home/me/wecom-agent/apps/api/data/wiki
# Docker Compose 会覆盖为 /data/wiki。
WIKI_ROOT=./data/wiki

# Wiki MCP Server 端口（本地默认 3001；端口冲突时可改为 3002 等）
WIKI_MCP_PORT=3001

# Wiki MCP 基础地址，API 健康检查使用；不要在这里追加 /sse。
# 在 MCP 服务器配置中使用 `${WIKI_MCP_URL}/sse`。
WIKI_MCP_URL=http://localhost:3001

# 是否允许执行 Skill 脚本（设为 true 才能运行）
SKILL_SCRIPTS_ENABLED=false
