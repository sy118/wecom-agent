# ─── 平台管理配置 ─────────────────────────────────────────────────────────────

# 管理员密码（必填）
ADMIN_PASSWORD=your-admin-password-here

# JWT 签名密钥（必填，建议使用随机字符串）
JWT_SECRET=your-jwt-secret-here

# 数据库文件路径（Docker 内路径，通常不需要修改）
DB_PATH=/data/wecom-platform.db

# API 服务端口（默认 3000）
API_PORT=3000

# API 服务监听地址；Web 开发代理默认连接该地址
API_HOST=127.0.0.1

# Web 管理台端口（默认 5173）
WEB_PORT=5173

# Web 管理台监听地址；需要局域网访问时可改为 0.0.0.0
WEB_HOST=127.0.0.1

# 是否允许执行 Skill 脚本（设为 true 才能运行）
SKILL_SCRIPTS_ENABLED=false

# Docker 构建使用的 Node 基础镜像（默认使用 Docker Hub 镜像源代理）
NODE_IMAGE=ca7kangnvcl9wf.xuanyuan.run/library/node:20-alpine

# 应用镜像仓库；ECS VPC 内推送可改为 registry-vpc.cn-hangzhou.aliyuncs.com/serein_ai/wecom-agent
DOCKER_IMAGE=registry.cn-hangzhou.aliyuncs.com/serein_ai/wecom-agent
DOCKER_TAG=latest

# 服务启动时自动启动 Bot 的并发上限
BOT_AUTO_START_CONCURRENCY=3

# Bot 跨会话消息处理并发；同一会话仍保持串行，避免上下文乱序
BOT_MESSAGE_CONCURRENCY=4

# 单个会话队列积压上限，超过后回复繁忙提示
BOT_QUEUE_BACKPRESSURE_LIMIT=10

# 图片/文件等生成任务后台执行并发
GENERATION_TASK_CONCURRENCY=2

# OceanBase MCP Server（真实密码只写入部署服务器的 .env）
OCEANBASE_MCP_AUTO_REGISTER=true
OCEANBASE_MCP_IMAGE=registry.cn-hangzhou.aliyuncs.com/serein_ai/wecom-agent
OCEANBASE_MCP_TAG=oceanbase-mcp-0.0.4
OCEANBASE_MCP_PYTHON_IMAGE=ca7kangnvcl9wf.xuanyuan.run/library/python:3.11-slim
OCEANBASE_MCP_TOKEN=
OCEANBASE_MCP_ENABLE_MEMORY=0
OCEANBASE_MCP_ALLOWED_HOSTS=oceanbase-mcp:*
OB_HOST=your-oceanbase-host
OB_PORT=2883
OB_USER="your-user@tenant#cluster"
OB_PASSWORD="your-oceanbase-password"
OB_DATABASE=your-database

# ─── 在线回复体验（agent-response-ux）───────────────────────────────────────

# 阶段心跳间隔（毫秒）；同阶段内进度更新的最小间隔
PROGRESS_HEARTBEAT_INTERVAL_MS=5000
PROGRESS_MILESTONE_MIN_INTERVAL_MS=30000

# 在线回复超时软提示阈值（毫秒）；超过后发送“仍在处理，当前处于 X 阶段”
RESPONSE_SOFT_PROMPT_THRESHOLD_MS=20000

# 队列积压提示阈值；同一会话排队消息数超过后提示“前面还有 N 条消息在排队”
BOT_QUEUE_BACKPRESSURE_HINT_THRESHOLD=3

# 企微被动回复协议：auto 自动探测 SDK 能力；force 强制占位；off 关闭占位仅心跳
WECOM_REPLY_STREAMING_MODE=auto

# ─── 企微媒体持久化（wecom-media-persistence）──────────────────────────────

# 媒体存储后端：local（默认）或 s3
WECOM_MEDIA_STORAGE=local
# 本地媒体根目录
WECOM_MEDIA_ROOT=./data/media
# 媒体保留时长（毫秒，默认 30 天）
WECOM_MEDIA_RETENTION_MS=2592000000
# 本地媒体总配额上限（字节，默认 10GB）
WECOM_MEDIA_QUOTA_BYTES=10737418240
# 即时下载并发上限
WECOM_MEDIA_DOWNLOAD_CONCURRENCY=4
# 下载失败重试窗口（毫秒，必须小于企微 5 分钟有效期）
WECOM_MEDIA_RETRY_WINDOW_MS=240000
# S3 兼容对象存储配置（WECOM_MEDIA_STORAGE=s3 时使用）
WECOM_MEDIA_S3_ENDPOINT=
WECOM_MEDIA_S3_REGION=
WECOM_MEDIA_S3_BUCKET=
WECOM_MEDIA_S3_ACCESS_KEY=
WECOM_MEDIA_S3_SECRET_KEY=

# ─── 企业产品化（enterprise-agent-productization）───────────────────────────

# 企微 5.0.10 CLI+MCP 集成开关
WECOM_CLI_MCP_ENABLED=false
# 企微 CLI MCP server 地址（stdio 命令或 SSE/Streamable HTTP URL）
WECOM_CLI_MCP_COMMAND=
WECOM_CLI_MCP_URL=
# 默认租户标识（多租户未启用时使用）
DEFAULT_TENANT_ID=default
# 写操作审批门开关；开启后写操作工具必须通过审批
APPROVAL_GATE_ENABLED=false
# 模板市场开关
TEMPLATE_MARKET_ENABLED=false
# 免打扰默认时段（24 小时制 HH:mm-HH:mm，逗号分隔多段）
DO_NOT_DISTURB_WINDOWS=
# 防打扰总开关；设为 true 才启用点名才回/免打扰时段/群消息节流（默认关闭，保持既有行为）
WECOM_DND_ENABLED=false
# 群聊点名才回；设为 true 后未点名群消息不回复
WECOM_DND_MENTION_ONLY=false
# 群消息节流窗口（毫秒）与合并上限
GROUP_THROTTLE_WINDOW_MS=10000
GROUP_THROTTLE_MAX_MESSAGES=3
